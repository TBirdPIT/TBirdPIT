# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor/temporary artifacts
*.tmp
*.temp
*.swp
*~

# Local VS Code transient state
.vscode/.history/
.vscode/*.log

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.python-version
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Coverage and test artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Azure and cloud local state
.azure/
.azd/
.terraform/
*.tfstate
*.tfstate.*

# AI and model artifacts
.cache/huggingface/
.cache/torch/
*.onnx
*.safetensors
*.pt
*.pth

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# Node/tooling artifacts (for polyglot projects)
node_modules/
pnpm-lock.yaml.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
